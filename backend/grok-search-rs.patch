 use thiserror::Error;
 
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum FailureProtocol {
+    Responses,
+    ChatCompletions,
+}
+
+impl FailureProtocol {
+    pub fn for_label(label: &str) -> Option<Self> {
+        match label {
+            "Grok Responses" => Some(Self::Responses),
+            "OpenAI-compatible" => Some(Self::ChatCompletions),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum FailureStage {
+    Request,
+    Response,
+    Parse,
+    Result,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum FailureReason {
+    AuthError,
+    RateLimited,
+    ModelNotFound,
+    ToolUnsupported,
+    InvalidRequest,
+    UpstreamError,
+    NetworkError,
+    Timeout,
+    ParseError,
+    ContentEmpty,
+    SourcesEmpty,
+}
+
+/// Diagnostics contain only local enums, status, and allowlisted codes.
+/// Never retain remote messages, URLs, headers, or credentials here.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct FailureData {
+    schema_version: u8,
+    provider: String,
+    protocol: FailureProtocol,
+    stage: FailureStage,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    http_status: Option<u16>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    upstream_code: Option<String>,
+    reason: FailureReason,
+}
+
+impl FailureData {
+    pub fn new(protocol: FailureProtocol, stage: FailureStage, reason: FailureReason) -> Self {
+        Self {
+            schema_version: 1,
+            provider: "grok".into(),
+            protocol,
+            stage,
+            http_status: None,
+            upstream_code: None,
+            reason,
+        }
+    }
+
+    pub fn with_status(mut self, status: u16) -> Self {
+        self.http_status = Some(status);
+        self
+    }
+
+    pub fn upstream(protocol: FailureProtocol, status: Option<u16>, raw: &Value) -> Self {
+        let code = raw
+            .pointer("/error/code")
+            .or_else(|| raw.pointer("/response/error/code"))
+            .or_else(|| raw.get("code"))
+            .and_then(Value::as_str)
+            .map(|code| code.trim().to_ascii_lowercase());
+        let known = code.as_deref().and_then(|code| {
+            let reason = match code {
+                "auth_error" | "invalid_api_key" | "authentication_error" | "permission_denied" => {
+                    FailureReason::AuthError
+                }
+                "rate_limited"
+                | "rate_limit_exceeded"
+                | "rate_limit_error"
+                | "insufficient_quota" => FailureReason::RateLimited,
+                "model_not_found" => FailureReason::ModelNotFound,
+                "tool_unsupported" | "unsupported_tool" | "unsupported_tools" => {
+                    FailureReason::ToolUnsupported
+                }
+                "invalid_request"
+                | "invalid_request_error"
+                | "unsupported_parameter"
+                | "context_length_exceeded" => FailureReason::InvalidRequest,
+                "upstream_error"
+                | "server_error"
+                | "internal_server_error"
+                | "service_unavailable" => FailureReason::UpstreamError,
+                _ => return None,
+            };
+            Some((code.to_string(), reason))
+        });
+        let mut data = Self::new(
+            protocol,
+            FailureStage::Response,
+            match status {
+                Some(401 | 403) => FailureReason::AuthError,
+                Some(429) => FailureReason::RateLimited,
+                Some(400 | 422) => FailureReason::InvalidRequest,
+                _ => FailureReason::UpstreamError,
+            },
+        );
+        data.http_status = status;
+        if let Some((code, reason)) = known {
+            data.upstream_code = Some(code);
+            data.reason = reason;
+        }
+        data
+    }
+}
+

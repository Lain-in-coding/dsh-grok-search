+struct Evidence {
+    sources: usize,
+    calls: Arc<AtomicUsize>,
+}
+
+#[async_trait]
+impl SourceProvider for Evidence {
+    async fn search_sources(&self, _: &str, _: usize, _: &SearchFilters) -> Result<Vec<Source>> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        Ok((0..self.sources)
+            .map(|i| Source::new(format!("https://evidence.example/{i}"), "tavily"))
+            .collect())
+    }
+    async fn fetch(&self, _: &str) -> Result<FetchedPage> {
+        panic!("inline fetch was disabled")
+    }
+    async fn map(&self, _: &str, _: usize) -> Result<Vec<Source>> {
+        panic!("unexpected map")
+    }
+}
+
+async fn invoke(ai: Arc<dyn AiProvider>, sources: usize, budget: usize) -> (Value, usize) {
+    let calls = Arc::new(AtomicUsize::new(0));
+    let service = SearchService::fake_custom(
+        Some(ai),
+        Arc::new(Evidence {
+            sources,
+            calls: calls.clone(),
+        }),
+        None,
+        [("GROK_SEARCH_FALLBACK_SOURCES", budget.to_string())],
+    );
+    let response = handle_message(&service, json!({"jsonrpc":"2.0","id":7,"method":"tools/call",
+        "params":{"name":"web_search","arguments":{"query":"test","extra_sources":0,"include_content":false}}}))
+        .await.unwrap();
+    (response, calls.load(Ordering::SeqCst))
+}
+
+fn provider(url: &str, timeout: Duration) -> Arc<dyn AiProvider> {
+    Arc::new(GrokResponsesProvider::with_client(
+        Client::builder()
+            .no_proxy()
+            .timeout(timeout)
+            .build()
+            .unwrap(),
+        url,
+        "test-only-key",
+        true,
+        false,
+    ))
+}
+
+async fn roundtrip(
+    status: u16,
+    content_type: &str,
+    body: String,
+    sources: usize,
+) -> (Value, Value, usize) {
+    let (url, server) = stub(status, content_type, body, Duration::ZERO).await;
+    let (response, calls) = invoke(provider(&url, Duration::from_secs(3)), sources, 2).await;
+    (response, server.await.unwrap(), calls)
+}
+
+fn data(reason: &str, stage: &str) -> Value {
+    json!({"schemaVersion":1,"provider":"grok","protocol":"responses","stage":stage,"reason":reason})
+}
+
+fn envelope(response: &Value) -> Value {
+    serde_json::from_str(response["result"]["content"][0]["text"].as_str().unwrap()).unwrap()
+}

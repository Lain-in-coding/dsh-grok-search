+#[test]
+fn dsh_upstream_code_union_is_normalized_and_unknown_values_are_omitted() {
+    let groups: &[(&str, &[&str])] = &[
+        (
+            "auth_error",
+            &[
+                "auth_error",
+                "invalid_api_key",
+                "authentication_error",
+                "permission_denied",
+            ],
+        ),
+        (
+            "rate_limited",
+            &[
+                "rate_limited",
+                "rate_limit_exceeded",
+                "rate_limit_error",
+                "insufficient_quota",
+            ],
+        ),
+        ("model_not_found", &["model_not_found"]),
+        (
+            "tool_unsupported",
+            &["tool_unsupported", "unsupported_tool", "unsupported_tools"],
+        ),
+        (
+            "invalid_request",
+            &[
+                "invalid_request",
+                "invalid_request_error",
+                "unsupported_parameter",
+                "context_length_exceeded",
+            ],
+        ),
+        (
+            "upstream_error",
+            &[
+                "upstream_error",
+                "server_error",
+                "internal_server_error",
+                "service_unavailable",
+            ],
+        ),
+    ];
+    assert_eq!(
+        groups.iter().map(|(_, codes)| codes.len()).sum::<usize>(),
+        20
+    );
+    for (reason, codes) in groups {
+        for code in *codes {
+            let actual = serde_json::to_value(FailureData::upstream(
+                FailureProtocol::Responses, Some(404),
+                &json!({"error":{"code":format!(" {} ", code.to_ascii_uppercase()),"message":SECRET}}),
+            )).unwrap();
+            let mut expected = data(reason, "response");
+            expected["httpStatus"] = json!(404);
+            expected["upstreamCode"] = json!(code);
+            assert_eq!(actual, expected);
+        }
+    }
+    for code in [
+        json!(SECRET),
+        json!("toString"),
+        json!("invalid_api_key-extra"),
+        json!(401),
+        json!({}),
+        Value::Null,
+    ] {
+        let actual = serde_json::to_value(FailureData::upstream(
+            FailureProtocol::Responses,
+            Some(422),
+            &json!({"error":{"code":code,"type":"api_error","message":SECRET}}),
+        ))
+        .unwrap();
+        let mut expected = data("invalid_request", "response");
+        expected["httpStatus"] = json!(422);
+        assert_eq!(actual, expected);
+    }
+    assert!(serde_json::from_value::<FailureData>(data(SECRET, "response")).is_err());
+}
